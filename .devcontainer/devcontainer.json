{
  "name": "upgraded-fiesta",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "bash .codex/setup.sh 2>/dev/null || true",
  "forwardPorts": [5173, 4173, 8080, 18789],
  "portsAttributes": {
    "5173": {
      "label": "UI · Vite Dev",
      "onAutoForward": "openPreview"
    },
    "4173": {
      "label": "UI · Vite Preview",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "hm-gateway"
    },
    "18789": {
      "label": "OpenClaw Bridge"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}