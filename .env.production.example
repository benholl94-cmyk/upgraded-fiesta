APP_ENV=production
COMPOSE_PROJECT_NAME=upgraded_fiesta
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
UI_BIND=0.0.0.0
UI_PORT=3000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=heavy
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=heavy_metal
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
HM_STORAGE_ROOT=./data/storage
HM_MEMORY_KEY=memory/index.json
HM_PLUGIN_MANIFEST=config/plugins.json
# Required: generate a real secret, e.g. `openssl rand -hex 32`. The gateway
# refuses to start without this unless HM_GATEWAY_ALLOW_NO_AUTH=true is set
# (local development only -- never in a reachable deployment).
HM_OWNER_TOKEN=change-me-generate-a-real-secret
