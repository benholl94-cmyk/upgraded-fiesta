# ── Deployment ────────────────────────────────────────────────────────────────
APP_ENV=production
COMPOSE_PROJECT_NAME=upgraded_fiesta

# ── hm-gateway ────────────────────────────────────────────────────────────────
# Bind-Adresse host:port — Gateway liest HM_GATEWAY_BIND (nicht GATEWAY_BIND)
HM_GATEWAY_BIND=0.0.0.0:8080

# Bearer-Token. Gateway startet nicht ohne diesen Wert.
# Generieren: openssl rand -hex 32
HM_OWNER_TOKEN=change-me-generate-a-real-secret

# Lokale Entwicklung ohne Auth (NIEMALS in produktiven Deployments!):
# HM_GATEWAY_ALLOW_NO_AUTH=true

# Zero-Staked-Modus (Gateway lehnt Tasks ab, meldet Rotation):
# HM_ZERO_STAKED=false

# Rate-Limiting pro IP/Minute (0 = deaktiviert):
HM_RATE_LIMIT_PER_MINUTE=120

# Plugin-Manifest:
HM_PLUGIN_MANIFEST=config/plugins.json

# Diagnostics-Key (Storage-Pfad für Berichte):
HM_DIAGNOSTICS_KEY=diagnostics/reports.json

# Knowledge-Graph-Seed (optional):
# HM_MEMORY_GRAPH_SEED_PATH=/app/data/graph-seed.json

# ── hm-storage ────────────────────────────────────────────────────────────────
HM_STORAGE_BACKEND=local
HM_STORAGE_ROOT=./data/storage
# HM_STORAGE_BACKEND=remote
# HM_REMOTE_STORAGE_URL=http://storage-host:8080
# HM_REMOTE_STORAGE_TOKEN=change-me

# ── hm-memory ─────────────────────────────────────────────────────────────────
HM_MEMORY_KEY=memory/index.json

# ── hm-cron ───────────────────────────────────────────────────────────────────
HM_CRON_CONFIG=config/cron.json

# ── Hardware Console ──────────────────────────────────────────────────────────
HM_CONSOLE_PORT=7799
HM_CONSOLE_BIND=0.0.0.0
# HM_CONSOLE_SECRET=change-me-or-leave-empty-for-no-auth
HM_GATEWAY_URL=http://127.0.0.1:8080

# ── Ollama LLM-Plugin ─────────────────────────────────────────────────────────
HM_OLLAMA_URL=http://localhost:11434
HM_OLLAMA_MODEL=llama3
HM_CLAUDE_TOOL=false
HM_CLAUDE_MODEL=claude-sonnet-4-6

# ── Legacy LLM-Plugin (llm_chat_plugin.py) ────────────────────────────────────
# HM_LLM_ENABLE=true
# HM_LLM_API_URL=https://api.openai.com/v1
# HM_LLM_API_KEY=sk-...
# HM_LLM_MODEL=gpt-4o

# ── HUGIN Oracle (scripts/hugin_oracle.py) ────────────────────────────────────
# HUGIN_GEMINI_KEY=...
# HUGIN_OPENAI_KEY=sk-...
# HUGIN_MISTRAL_KEY=...
# HUGIN_LOCAL_MODEL=llama3

# ── Channel-Bot-Tokens ────────────────────────────────────────────────────────
# HM_TELEGRAM_BOT_TOKEN=...
# HM_DISCORD_BOT_TOKEN=...
# HM_SLACK_BOT_TOKEN=...
# HM_SLACK_APP_TOKEN=...
# HM_WHATSAPP_BOT_TOKEN=...
# HM_WHATSAPP_VERIFY_TOKEN=...

# ── Infrastruktur ─────────────────────────────────────────────────────────────
# Hinweis: Postgres + Redis starten via docker-compose.yml, aber keine
# Rust-Crate verbindet sich derzeit damit (reserviert für spätere Phase).
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=heavy
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=heavy_metal
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# ── UI (Legacy docker-compose Felder) ─────────────────────────────────────────
UI_BIND=0.0.0.0
UI_PORT=3000
