# ── Deployment ────────────────────────────────────────────────────────────────
APP_ENV=production
COMPOSE_PROJECT_NAME=upgraded_fiesta

# ── hm-gateway ────────────────────────────────────────────────────────────────
# Bind-Adresse host:port — Gateway liest HM_GATEWAY_BIND (nicht GATEWAY_BIND)
HM_GATEWAY_BIND=0.0.0.0:8080

# Bearer-Token. Gateway startet nicht ohne diesen Wert.
# Generieren: openssl rand -hex 32
HM_OWNER_TOKEN=change-me-generate-a-real-secret

# Lokale Entwicklung ohne Auth (NIEMALS in produktiven Deployments!):
# HM_GATEWAY_ALLOW_NO_AUTH=true

# Zero-Staked-Modus (Gateway lehnt Tasks ab, meldet Rotation):
# HM_ZERO_STAKED=false

# Rate-Limiting pro IP/Minute (0 = deaktiviert):
HM_RATE_LIMIT_PER_MINUTE=120

# Plugin-Manifest:
HM_PLUGIN_MANIFEST=config/plugins.json

# Diagnostics-Key (Storage-Pfad für Berichte):
HM_DIAGNOSTICS_KEY=diagnostics/reports.json

# Knowledge-Graph-Seed (data/graph-seed.json ist vorhanden — generiert via generate_knowledge_graph_seed.py):
HM_MEMORY_GRAPH_SEED_PATH=data/graph-seed.json

# CORS-Allowlist: die Origin, von der die HUGIN-PWA geladen wird.
# Ohne sie blockiert der BROWSER die Antwort, obwohl das Gateway korrekt
# geantwortet hat — der Fehler sieht aus wie ein Netzproblem und ist keines.
# curl bleibt davon unberuehrt, was die Fehlersuche zusaetzlich in die Irre
# fuehrt. Fuer GitHub Pages:
# HM_ALLOWED_ORIGINS=https://benholl94-cmyk.github.io

# ── POST /chat: das Gehirn hinter dem Befehlskanal ────────────────────────────
# Arbeitsverzeichnis des Subprozesses `python3 -m agents.brain`. Im
# Container-Image auf /app gesetzt (siehe Dockerfile); im Checkout ist der
# Standard richtig.
# HM_BRAIN_REPO=.
# Interpreter, mit dem das Gehirn gestartet wird:
# HM_BRAIN_PYTHON=python3

# ── hm-storage ────────────────────────────────────────────────────────────────
HM_STORAGE_BACKEND=local
HM_STORAGE_ROOT=./data/storage
# HM_STORAGE_BACKEND=remote
# HM_REMOTE_STORAGE_URL=http://storage-host:8080
# HM_REMOTE_STORAGE_TOKEN=change-me

# ── hm-memory ─────────────────────────────────────────────────────────────────
HM_MEMORY_KEY=memory/index.json

# ── hm-cron ───────────────────────────────────────────────────────────────────
HM_CRON_CONFIG=config/cron.json

# ── Hardware Console ──────────────────────────────────────────────────────────
HM_CONSOLE_PORT=7799
HM_CONSOLE_BIND=0.0.0.0
# HM_CONSOLE_SECRET=change-me-or-leave-empty-for-no-auth
HM_GATEWAY_URL=http://127.0.0.1:8080

# ── hm-tools ─────────────────────────────────────────────────────────────────
# hm-tool-browser: Chrome DevTools Protocol-Endpoint (überschreibt ws://localhost:9222).
# Nur setzen wenn ein Chrome/Chromium mit --remote-debugging-port=9222 laeuft.
# HM_BROWSER_CDP_URL=ws://localhost:9222

# ── Channels (outbound) ───────────────────────────────────────────────────────
# Wenn true, loggt channel_send_plugin.py die Nutzlast nur und sendet nichts
# raus. Praktisch fuer Tests und iPhone-Demos ohne echte Bot-Tokens.
# HM_CHANNEL_DRY_RUN=true

# ── Watchdog (hm_gateway_watchdog.py) ─────────────────────────────────────────
# Health-URL die alle 30 s gepollt wird (Standard = http://127.0.0.1:8080/health).
# HM_WATCHDOG_HEALTH_URL=http://127.0.0.1:8080/health
# systemd-Unit die bei Fehler neugestartet wird.
# HM_WATCHDOG_UNIT=hm-gateway.service
# HTTP-Timeout in Sekunden (Standard: 5).
# HM_WATCHDOG_TIMEOUT_SECONDS=5
# Auto-Restart bei Health-Fail (true/false, Standard: true).
# HM_WATCHDOG_RESTART=true

# ── llm-key-manager (scripts/llm_key_manager.py) ──────────────────────────────
# Pfad zur lokalen JSON-Datei mit rotierten LLM-Keys.
# Standard: ~/.config/hm-gateway/llm-keys.json
# HM_LLM_KEYS_FILE=~/.config/hm-gateway/llm-keys.json
# Welche Datei aktuell "aktiv" rotiert wird (fuer Operator-Hinweise).
# HM_LLM_ACTIVE_FILE=openai

# ── Ollama (lokales LLM, kein Egress) ─────────────────────────────────────────
# Lokales Ollama-Gateway; nur aktiv wenn HM_OLLAMA_ENABLE=true gesetzt ist.
# HM_OLLAMA_ENABLE=true
HM_OLLAMA_URL=http://localhost:11434
HM_OLLAMA_MODEL=llama3

# ── Lokales Modell (hugin_local_model.py) ─────────────────────────────────────
# Standard-Endpunkt ohne Ollama; zeigt auf einen lokalen OpenAI-kompatiblen
# HTTP-Server (z.B. llama.cpp, vLLM, LM-Studio).
HM_LOCAL_LLM_URL=http://127.0.0.1:8081

# ── Claude-Tool (Plugin) ──────────────────────────────────────────────────────
HM_CLAUDE_TOOL=false
HM_CLAUDE_MODEL=claude-sonnet-4-6

# ── Legacy LLM-Plugin (llm_chat_plugin.py) ────────────────────────────────────
# HM_LLM_ENABLE=true
# HM_LLM_API_URL=https://api.openai.com/v1
# HM_LLM_API_KEY=sk-...
# HM_LLM_MODEL=gpt-4o

# ── HUGIN Oracle (scripts/hugin_oracle.py) ────────────────────────────────────
# HUGIN_GEMINI_KEY=...
# HUGIN_OPENAI_KEY=sk-...
# HUGIN_MISTRAL_KEY=...
# HUGIN_LOCAL_MODEL=llama3

# ── Channel-Bot-Tokens ────────────────────────────────────────────────────────
# HM_TELEGRAM_BOT_TOKEN=...
# HM_DISCORD_BOT_TOKEN=...
# HM_SLACK_BOT_TOKEN=...
# HM_SLACK_APP_TOKEN=...
# HM_WHATSAPP_BOT_TOKEN=...
# HM_WHATSAPP_VERIFY_TOKEN=...
# Phone-Number-ID aus Meta Business Manager (Pflicht fuer WhatsApp-Versand):
# HM_WHATSAPP_PHONE_ID=...

# ── Infrastruktur ─────────────────────────────────────────────────────────────
# Hinweis: Postgres + Redis starten via docker-compose.yml, aber keine
# Rust-Crate verbindet sich derzeit damit (reserviert für spätere Phase).
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=heavy
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=heavy_metal
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# ── UI (Legacy docker-compose Felder) ─────────────────────────────────────────
UI_BIND=0.0.0.0
UI_PORT=3000

# Origins die das Gateway aus einem Browser aufrufen duerfen, kommasepariert.
# Seit PR #76 ist die Voreinstellung LEER = keine fremde Origin. Ohne Eintrag
# erreicht die PWA das Gateway nicht mehr -- das ist der haeufigste Grund,
# warum es nach einem Deploy "plötzlich nicht geht".
# Wildcard bleibt moeglich, muss aber hingeschrieben werden: HM_ALLOWED_ORIGINS=*
HM_ALLOWED_ORIGINS=https://benholl94-cmyk.github.io
