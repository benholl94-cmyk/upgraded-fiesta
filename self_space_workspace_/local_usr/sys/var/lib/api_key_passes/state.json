      "\\bunlimited\\b",
      "\\bno\\s*limit\\b",
      "\\bbypass\\b",
      "\\bquota\\s*(bypass|avoid|evade)\\b",
      "\\brate\\s*limit\\s*(bypass|avoid|evade)\\b",
      "\\bfree\\s*credits?\\s*(bypass|farm|abuse)\\b"
    ]
