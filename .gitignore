# Local environment files
.env
.env.*.local
*.local.env

# Local credential material
*.pem
*.p12
*.pfx
*.secret
*.secrets

# Signal CLI local state and runtime data
integrations/signal-cli/.env.signal.local
integrations/signal-cli/data/
settings/signal-cli-client.local.json

# Runtime output
logs/
runs/
backups/
exports/
.tmp/
.cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Coverage-Messartefakte. Die Zahlen gehoeren in den Bericht
# (docs/completion-report.json), die Rohdaten nicht in die Historie: .coverage
# ist eine SQLite-Datei, die sich bei jedem Lauf aendert, und ein binaerer
# Blob, der pro Messung neu committet wird, waere genau die Sorte
# hochfrequenter Schreibvorgang, die das Repo schon bei munin-state.json
# getrennt hat. Reproduzierbar ueber die im Bericht notierten Kommandos.
# Rust-Coverage landet unter target/llvm-cov-target und ist damit bereits
# ueber target/ abgedeckt.
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Rust and JavaScript dependency/build output
target/
ui/node_modules/
node_modules/
Cargo.lock
ui/package-lock.json

# Daemon runtime output — written every 5s, never committed
ui/public/platform-status.json

# munin_link.py local runtime output (wrong REPO_ROOT would place it here)
.claude/.claude/
logs/
.claude/persona/.dev-token

# LLM runtime state — enthält API-Keys wenn ein bezahlter Provider aktiv ist
config/llm-active.json
config/knowledge-loop-state.json

# Autonomy core live-state — kontinuierlich vom laufenden Daemon aktualisiert
.claude/persona/repo-index.json
.claude/persona/tracker-report.json
.claude/persona/autonomy-state.json
.claude/persona/console-log.json
.claude/persona/security-report.json
.claude/persona/security-baseline.json
.claude/persona/munin-state.json

# Agenten-Ledger — Laufzeitprotokoll, wird pro Lauf fortgeschrieben
.claude/agents/ledger.jsonl

# Keyring-Ablage — Master-Seed, niemals im Index
.hugin/

# Container-Spiegel, seit PR #74/Folgearbeit nicht mehr getrackt.
# Bleibt lokal liegen; ohne diesen Eintrag meldet der Stop-Hook ihn dauerhaft.
self_space_workspace_/

# Laufzeitartefakte, die beim Betrieb des Gateways entstehen. Beide sind
# Zustand einer Ausfuehrung, nicht Inhalt des Repos: data/storage/ ist der
# Standard-HM_STORAGE_ROOT, .claude/relay/ der Subroom plus die von
# agents/brain.py geschriebene Grammatik. Getrackt waeren sie genau die Art
# toter Daten, die hier schon einmal aufgeraeumt wurde.
data/storage/
.claude/relay/

# Lokaler Modellkern (T1b). Beides ist reproduzierbar, aber zu gross und zu
# maschinenabhaengig fuer die Historie:
#   models/model.gguf   7,03 GB — laege nach einem Commit in JEDEM Clone fuer
#                       immer, auch nach dem Loeschen. Gepinnt in
#                       config/model.json (Repo, Datei, SHA-256).
#   vendor/llama.cpp/   selbst gebaute Binaries plus Quellbaum, gebaut mit
#                       -DGGML_NATIVE=ON also auf die CPU dieser Maschine.
# Wiederherstellung, ohne Rueckfrage:
#   python3 scripts/hugin_local_model.py setup
models/
vendor/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
