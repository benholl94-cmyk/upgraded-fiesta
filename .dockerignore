# .dockerignore — Build-Kontext klein halten.
#
# Ohne diese Datei schickt `docker build` das GESAMTE Repo-Working-Tree
# in den Builder (~600 MB wegen models/, data/, target/, .git/, ui/node_modules/).
# Mit dieser Datei: ~30 MB (nur Code + Cargo.toml).
#
# Faustregel: alles rein, was die Container NICHT braucht — alles raus,
# was nur lokale Entwicklung betrifft.

# Build-Artefakte (Rust + Node)
target/
ui/dist/
ui/node_modules/
**/node_modules/
**/target/

# VCS + Editor-Metadaten
.git/
.github/
.idea/
.vscode/
*.swp
*.swo

# Daten + Modelle (zu gross, oft lokal-only)
data/
models/
self_space_workspace_/
.claude/persona/autonomy-state.json
.claude/persona/munin-state.json

# Logs + Test-Artefakte
logs/
coverage/
*.log
.coverage
htmlcov/
.pytest_cache/

# Doku (gehoert nicht ins Image)
docs/
*.md
!README.md

# Konfigurations-Backups
*.bak
*.orig
*.local

# Docker selbst (kein rekursiver Build)
Dockerfile*
.dockerignore
docker-compose*.yml
deploy/

# Lokale Envs + Secrets
.env
.env.*
!.env.production.example

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/