# systemd unit for running the real hm-gateway (crates/hm-gateway) as a
# persistent, hardened, always-on service on a small VPS/host -- the
# deployment target implied by the mobile-first operating model (the
# operator drives this from an iPhone, the gateway itself runs unattended
# on a remote host).
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin hm-gateway
#   sudo mkdir -p /opt/hm-gateway/storage
#   sudo chown hm-gateway:hm-gateway /opt/hm-gateway/storage
#   sudo install -m 0755 target/release/hm-gateway /opt/hm-gateway/hm-gateway
#   sudo install -m 0640 -o hm-gateway -g hm-gateway /dev/null /etc/hm-gateway.env
#   # then put HM_OWNER_TOKEN=... (and any other HM_* overrides) into /etc/hm-gateway.env
#   sudo install -m 0644 deploy/hm-gateway.service /etc/systemd/system/hm-gateway.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hm-gateway
#
# Verify: `systemd-analyze verify hm-gateway.service` (run from this directory).

[Unit]
Description=hm-gateway (Fullstack Heavy Metal gateway)
Documentation=https://github.com/benholl94-cmyk/upgraded-fiesta/blob/main/docs/production-api-contract.md
After=network-online.target
Wants=network-online.target
# Back off restarts so a persistent failure doesn't spin the CPU or spam
# the journal: at most 5 restarts within any 60s window.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/hm-gateway/hm-gateway
EnvironmentFile=/etc/hm-gateway.env
Environment=HM_STORAGE_ROOT=/opt/hm-gateway/storage

# Restart on crash or hang-detected-by-watchdog.
Restart=on-failure
RestartSec=2s

# hm-gateway handles SIGTERM by draining in-flight connections and exiting
# cleanly (see main.rs); give it real time to do that before systemd
# escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=15s

# --- Hardening ---
# Dedicated, unprivileged, non-interactive user (create with the useradd
# command above); never run this as root.
User=hm-gateway
Group=hm-gateway
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# The only path the process needs to write to.
ReadWritePaths=/opt/hm-gateway/storage

# Resource limits -- a single-tenant gateway process has no business
# consuming unbounded memory/CPU/file descriptors.
MemoryMax=512M
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
