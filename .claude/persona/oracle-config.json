{
  "schema": "oracle.config.v1",
  "note": "Provider-Konfiguration für hugin_oracle.py. Keys werden NIEMALS hier gespeichert — nur via Umgebungsvariablen (HUGIN_GEMINI_KEY, HUGIN_OPENAI_KEY, HUGIN_MISTRAL_KEY).",
  "default_provider": "auto",
  "provider_priority": ["gemini", "openai", "mistral", "local"],
  "audit_log": "logs/oracle-audit.jsonl",
  "max_prompt_chars": 2000,
  "max_response_chars": 8000,
  "rate_limit": {
    "requests_per_minute": 10,
    "cooldown_secs": 6
  },
  "security": {
    "forbidden_patterns": ["token", "api[_-]?key", "secret", "password", "HM_OWNER"],
    "strip_repo_paths": true,
    "log_all_requests": true
  },
  "providers": {
    "gemini": {
      "env_key": "HUGIN_GEMINI_KEY",
      "model": "gemini-1.5-flash",
      "skills": ["research", "brainstorm", "translate"]
    },
    "openai": {
      "env_key": "HUGIN_OPENAI_KEY",
      "model": "gpt-4o-mini",
      "skills": ["research", "code-review", "brainstorm"]
    },
    "mistral": {
      "env_key": "HUGIN_MISTRAL_KEY",
      "model": "mistral-small-latest",
      "skills": ["research", "translate"]
    },
    "local": {
      "env_key": null,
      "model": "llama3",
      "skills": ["research", "code-review", "brainstorm", "translate"],
      "note": "Erfordert laufendes Ollama auf HM_OLLAMA_URL"
    }
  }
}
